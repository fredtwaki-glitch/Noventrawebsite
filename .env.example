# Copy this file to .env.local for local development,
# and set the same variables in your host's dashboard (e.g. Render.com) for production.

# Required — get one free at https://resend.com/api-keys
RESEND_API_KEY=

# Where Quote / Demo / newsletter-fallback notifications are sent
CONTACT_TO_EMAIL=hello@noventra.tech

# Sender identity. Until you verify your own domain in Resend, you must use
# their shared test sender below. Once your domain is verified in Resend,
# change this to something like: Noventra <hello@noventra.tech>
CONTACT_FROM_EMAIL="Noventra Website <onboarding@resend.dev>"

# Optional — create an Audience in Resend and paste its ID here to have
# Newsletter signups added as real contacts instead of just emailing you.
RESEND_AUDIENCE_ID=
